# Server-only configuration. No credentials in source or NEXT_PUBLIC variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
# Full OpenAI-compatible API base URL, e.g. https://host/api/v1 (without /chat/completions).
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=
# Required verified upper limit of prompt tokens for this provider/model.
DEEPSEEK_MAX_INPUT_TOKENS=
NEX_BASE_URL=
NEX_API_KEY=
NEX_MODEL_ID=nex-agi/nex-n2.5-pro:free
NEX_MAX_INPUT_TOKENS=
YOOKASSA_SHOP_ID=1411296
YOOKASSA_SECRET_KEY=
# Generate independent random secrets (at least 32 characters).
REQUEST_FINGERPRINT_SECRET=
CRON_SECRET=
# Verify allowed request duration against your Vercel plan.
UPSTREAM_TIMEOUT_MS=90000
